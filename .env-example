###
### Variables for error reporting to Sentry
###

# The Sentry DSN for the project errors are reported to. Leaving this unset
# (the default for local development) disables error reporting entirely.
SENTRY_DSN=

# The environment name events are tagged with in Sentry, e.g. 'dev' or 'prod'.
# Defaults to 'local-development' when unset.
SENTRY_ENVIRONMENT=

# The proportion of transactions (0.0 to 1.0) sent to Sentry for performance
# tracing. Defaults to 1.0 when unset.
SENTRY_TRACES_SAMPLE_RATE=
